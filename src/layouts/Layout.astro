---
import "@fontsource/spectral/300.css";
import "@fontsource/spectral/400.css";
import "@fontsource/spectral/400-italic.css";
import "../styles/tokens.css";

interface Props {
  title: string;
  description?: string;
  /** Wrap the page in a readable article column. Full-bleed pages (homepage,
      medium indexes) opt out and manage their own sections. */
  constrained?: boolean;
}
const {
  title,
  description = "Alexandra Arshanskaya — painter and performance artist, The Hague. Paintings, drawings, performance and space projects.",
  constrained = true,
} = Astro.props;
const siteTitle = "Alexandra Arshanskaya";

const navItems = [
  { label: "Paintings", href: "/paintings/" },
  { label: "Drawings", href: "/drawings/" },
  { label: "Performance", href: "/category/performance/" },
  { label: "Space", href: "/vanishing-point-project-for-moon-gallery/" },
  { label: "About", href: "/about/" },
  { label: "Contact", href: "/contact-form/" },
];
const currentPath = Astro.url.pathname.replace(/\/?$/, "/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === siteTitle ? siteTitle : `${title} — ${siteTitle}`}</title>
    <meta name="description" content={description} />
    <link rel="alternate" type="application/rss+xml" title={siteTitle} href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <div class="shell">
      <header>
        <nav class="site-nav">
          <a class="wordmark" href="/">{siteTitle}</a>
          <div class="nav-links">
            {navItems.map((item) => (
              <a href={item.href} class:list={{ active: currentPath === item.href }}>{item.label}</a>
            ))}
          </div>
        </nav>
        <div class="hairline"></div>
      </header>
      <main>
        {constrained ? <div class="prose">{<slot />}</div> : <slot />}
      </main>
      <footer class="site-footer">
        <span>&copy; {new Date().getFullYear()} Alexandra Arshanskaya · The Hague</span>
        <div class="footer-links">
          <a href="/contact-form/">Contact</a>
          <a href="/rss.xml">RSS</a>
        </div>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    background: var(--bg);
    color: var(--ink);
  }

  body {
    font-family: var(--font-ui);
    line-height: 1.6;
  }

  a {
    color: inherit;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }

  a:hover {
    opacity: 0.62;
  }

  img {
    display: block;
    max-width: 100%;
  }

  /* Readable column for article-type pages (posts, migrated WP pages). */
  .prose {
    max-width: 46rem;
    margin: 0 auto;
    padding: 3rem var(--gutter) 5rem;
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: 1.05rem;
    color: var(--serif-ink-soft);
  }

  .prose h1,
  .prose h2,
  .prose h3 {
    font-family: var(--font-serif);
    font-weight: 400;
    line-height: 1.2;
    color: var(--serif-ink);
  }

  .prose h1 {
    font-size: 2.5rem;
  }

  .prose a {
    border-bottom: 1px solid var(--ink);
  }

  .prose img {
    height: auto;
  }

  .prose iframe {
    max-width: 100%;
  }
</style>

<style>
  .shell {
    max-width: var(--max-shell);
    margin: 0 auto;
    background: var(--bg);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
  }

  .site-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
    padding: 32px var(--gutter);
  }

  .wordmark {
    font-size: 14px;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    font-weight: 500;
    white-space: nowrap;
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    font-size: 11px;
    letter-spacing: var(--track-nav);
    text-transform: uppercase;
    color: var(--muted-ink);
  }

  .nav-links a.active {
    color: var(--ink);
    border-bottom: 1px solid var(--ink);
    padding-bottom: 3px;
  }

  .hairline {
    height: 1px;
    background: var(--rule);
    margin: 0 var(--gutter);
  }

  .site-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    padding: 40px var(--gutter);
    background: var(--ink);
    color: var(--footer-text);
    font-size: 12px;
    letter-spacing: 0.12em;
  }

  .footer-links {
    display: flex;
    gap: 26px;
  }

  @media (max-width: 900px) {
    .site-nav {
      padding-top: 24px;
      padding-bottom: 20px;
    }

    .nav-links {
      gap: 18px;
    }
  }
</style>
